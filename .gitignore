# Ignore common build and executable files

# Build directories
build/
bin/
out/
obj/

# Common executables and binaries
*.exe
*.out
a.out

# Object and archive files
*.o
*.a

# Shared libraries
*.so
*.dylib
*.dll

# Compiled classes and bytecode
*.class
__pycache__/
*.py[cod]

# Editor and temp files
*~
*.swp
*.swo

# Note: Gitignore matches paths/patterns, not file permission bits.
# To stop tracking already-committed executables, remove them from the index (see commands below).
