# Ignore common build and executable files

# Build directories
build/
bin/
out/
obj/

# Common executables and binaries
*.exe
*.out
a.out

# Object and archive files
*.o
*.a

# Shared libraries
*.so
*.dylib
*.dll

# Compiled classes and bytecode
*.class
__pycache__/
*.py[cod]

# Editor and temp files
*~
*.swp
*.swo

# Note: Gitignore matches paths/patterns, not file permission bits.
# To stop tracking already-committed executables, remove them from the index (see commands below).

# Additional patterns to catch common compiled/portable executables anywhere in the tree
# (gitignore cannot match files by executable permission; the pre-commit hook below enforces that)
a.out
*.out
*.exe
*.bin

# Common build artifacts and libraries
*.o
*.a
*.so
*.dylib
*.dll

# Bin directories (some projects put executables here)
bin/
out/
build/

# If you compile inside chapter folders, ignore typical program outputs
**/a.out
**/*.out
**/*.exe

# End
